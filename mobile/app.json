{
  "expo": {
    "name": "QuickTab",
    "slug": "quicktab",
    "scheme": "quicktab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fafaf9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.quicktab.mobile",
      "associatedDomains": ["applinks:quicktabapp.vercel.app"]
    },
    "android": {
      "package": "app.quicktab.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "quicktabapp.vercel.app", "pathPrefix": "/g/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-sharing"],
    "experiments": { "typedRoutes": true }
  }
}
